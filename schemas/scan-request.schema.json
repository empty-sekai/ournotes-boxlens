{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ournotes-boxlens:schema:scan-request:1",
  "title": "Our Notes BoxLens scan-request v1",
  "type": "object",
  "required": [
    "images"
  ],
  "properties": {
    "schema": {
      "const": "ournotes-boxlens.scan-request/1"
    },
    "player": {
      "type": "string",
      "maxLength": 100
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "data": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
