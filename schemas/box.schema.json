{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ournotes-boxlens:schema:box:1",
  "title": "Our Notes BoxLens box v1",
  "type": "object",
  "required": [
    "schema",
    "player",
    "coverage",
    "cards",
    "unique_count",
    "observations",
    "duplicate_observations"
  ],
  "properties": {
    "schema": {
      "const": "bdon-box/1"
    },
    "player": {
      "type": "string"
    },
    "coverage": {
      "const": "observed_only"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "name",
          "sources",
          "source_ids",
          "conflicts",
          "level",
          "card_rank",
          "awake_count"
        ],
        "properties": {
          "kind": {
            "enum": [
              "member",
              "snap"
            ]
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "object",
            "properties": {
              "level": {
                "type": "object",
                "patternProperties": {
                  "^[1-9][0-9]*$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "source_id",
                        "confidence"
                      ],
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "source_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "card_rank": {
                "type": "object",
                "patternProperties": {
                  "^[1-9][0-9]*$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "source_id",
                        "confidence"
                      ],
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "source_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "awake_count": {
                "type": "object",
                "patternProperties": {
                  "^[1-9][0-9]*$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "source_id",
                        "confidence"
                      ],
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "source_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "level": {
            "type": "object",
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "const": "manual"
              }
            },
            "additionalProperties": false
          },
          "card_rank": {
            "type": "object",
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "const": "manual"
              }
            },
            "additionalProperties": false
          },
          "awake_count": {
            "type": "object",
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "const": "manual"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "unique_count": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_observations": {
      "type": "integer",
      "minimum": 0
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "field",
          "previous",
          "previous_conflicts",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "member",
              "snap"
            ]
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "field": {
            "enum": [
              "level",
              "card_rank",
              "awake_count"
            ]
          },
          "previous": {
            "type": "object",
            "required": [
              "value",
              "confidence"
            ],
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "const": "manual"
              }
            },
            "additionalProperties": false
          },
          "previous_conflicts": {
            "anyOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[1-9][0-9]*$": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "source",
                        "source_id",
                        "confidence"
                      ],
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "source_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "recognition_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "files",
          "galleries",
          "inference_core_sha256",
          "onnxruntime_version"
        ],
        "properties": {
          "schema": {
            "const": "ournotes-boxlens.recognition-provenance/2"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "galleries": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "snap": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "member",
              "snap"
            ],
            "additionalProperties": false
          },
          "inference_core_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "onnxruntime_version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
